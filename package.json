{
  "name": "midi-song-creation-tool",
  "version": "1.0.0",
  "description": "A full-featured MIDI song creation tool with piano roll, pattern generators, and more",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/server/server.js",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "nodemon src/server/server.js",
    "client": "webpack serve --mode development",
    "build": "webpack --mode production",
    "test": "jest --config jest.config.js"
  },
  "keywords": [
    "midi",
    "music",
    "composition",
    "daw"
  ],
  "author": "Asabaal",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/plugin-transform-runtime": "^7.28.5",
    "@babel/preset-env": "^7.24.0",
    "@babel/preset-react": "^7.23.3",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.2.1",
    "babel-jest": "^29.7.0",
    "babel-loader": "^10.0.0",
    "concurrently": "^9.2.1",
    "core-js": "^3.47.0",
    "css-loader": "^7.1.2",
    "html-webpack-plugin": "^5.6.5",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-canvas-mock": "^2.5.2",
    "jest-environment-jsdom": "^29.7.0",
    "mongodb-memory-server": "^9.1.6",
    "nodemon": "^3.1.11",
    "style-loader": "^4.0.0",
    "supertest": "^6.3.4",
    "webpack": "^5.103.0",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "express": "^4.18.3",
    "midi-writer-js": "^2.1.4",
    "mongoose": "^8.2.1",
    "prop-types": "^15.8.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tone": "^14.8.49",
    "uuid": "^9.0.1"
  }
}
